# Auth.js — https://authjs.dev/getting-started/installation
# REQUIRED: encrypts cookies / JWT. Generate: npx auth secret
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create "OAuth client ID" (Web). REQUIRED for "Sign in with Google".
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local dev: set so redirects match your app URL (fixes some AuthError cases)
AUTH_URL=http://localhost:3000

# Admin API (existing)
ADMIN_SECRET=
